{
  "name": "personal-workout",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --only auth,firestore --ui \"pnpm dev:app\"",
    "dev:app": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:remote": "node scripts/dev-remote.ts",
    "preview:remote": "node scripts/dev-remote.ts preview",
    "build": "tsc -b && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "preview:e2e": "node scripts/test-env.ts preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && pnpm format:check && pnpm lint:fsd && pnpm lint:colors",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:fsd": "steiger ./src",
    "lint:colors": "! grep -rnEi --include='*.css' --exclude=tokens.css '(^|[^a-z0-9&/])#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})([^a-z0-9_-]|$)|(^|[^a-z0-9_-])(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\(' src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project ui",
    "test:watch": "vitest --project unit --project ui",
    "test:rules": "node scripts/test-env.ts rules",
    "e2e": "playwright test",
    "e2e:offline": "E2E_OFFLINE=1 playwright test --project offline",
    "e2e:ui": "playwright test --ui",
    "emulators": "firebase emulators:start --only auth,firestore",
    "deploy": "pnpm build && firebase deploy --only hosting,firestore --project prod",
    "catalog": "node scripts/fetch-catalog.ts && node scripts/build-catalog.ts",
    "check": "pnpm catalog && pnpm typecheck && pnpm test && pnpm build && pnpm lint && pnpm test:rules && E2E_OFFLINE=1 pnpm e2e && pnpm audit && pnpm audit signatures"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.22.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.105.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "firebase": "13.2.0",
    "lucide-react": "1.68.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@tanstack/eslint-plugin-query": "5.105.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.34.2",
    "jsdom": "30.1.3",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "steiger": "0.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
