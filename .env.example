# Copy to .env.local and uncomment what you need. Unset keys fall back to the emulators with
# project demo-workout; an empty value would override that fallback, so keep unused keys commented.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# host:port, used only in dev and test
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
