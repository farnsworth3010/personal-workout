# `vite build --mode e2e`: a production build wired to the emulators (src/shared/api/firebase.ts).
# This file outranks .env.local, so a real project there never reaches this build.
VITE_E2E=1
VITE_FIREBASE_PROJECT_ID=demo-workout
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-workout.firebaseapp.com
